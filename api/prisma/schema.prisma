// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model product {
  id Int @id @unique @default(autoincrement())
  uuid String @unique @default(uuid())
  product_sku String @unique
  product_title String
  category String
  unit String
  cost_price Decimal @db.Decimal(15, 2)
  selling_price Decimal @db.Decimal(15, 2)
  stock Int
  minimum_stock Int
  rack String
  description String @db.LongText
  thumbnail String? @db.LongText
  status Boolean @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  transaction_items TransactionItem[]

  stockAuditTrails  StockAuditTrail[]
  stockOpnameItems StockOpnameItem[]
}

enum UserRole {
  SUPER_ADMIN @map("super-admin")
  STAFF @map("staff")
}

enum DiscountType {
  percent
  nominal
}

model User {
  id Int @id @default(autoincrement())
  username String @unique
  email String @unique
  password String @unique
  refresh_token String? @db.Text
  role UserRole
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  transactions Transaction[]

  @@map("users")

  stockAuditTrails  StockAuditTrail[]
  stockOpnames StockOpname[]
}

model Transaction {
  id Int @id @default(autoincrement())
  user_id Int
  transaction_code String @unique
  total_price Decimal @db.Decimal(15, 2)
  discount_type DiscountType
  discount_amount Decimal @db.Decimal(15, 2)
  grand_total Decimal @db.Decimal(15, 2)
  payment_method String
  created_at DateTime @default(now())
  user User @relation(fields: [user_id], references: [id])
  transaction_items TransactionItem[]

  @@index([user_id])
  @@map("transactions")
}

model TransactionItem {
  id Int @id @default(autoincrement())
  transaction_id Int
  product_id Int
  unit_price Decimal @db.Decimal(15, 2)
  qty Int
  total Decimal @db.Decimal(15, 2)
  transaction Transaction @relation(fields: [transaction_id], references: [id])
  product product @relation(fields: [product_id], references: [id])

  @@index([transaction_id])
  @@index([product_id])
  @@map("transaction_items")
}

model Supplier {
  id                      Int      @id @default(autoincrement())
  suppliers_code          String   @unique @db.VarChar(50)  // kode_supplier
  name                    String   @db.VarChar(150)         // nama_supplier
  pic                     String?  @db.VarChar(100)         // pic (bikin opsional (?) kalau sewaktu-waktu belum ada)
  phone                   String   @db.VarChar(20)          // nomor_telepon
  email                   String?  @db.VarChar(100)         // email (opsional, jaga-jaga kalau supplier lokal gak punya email)
  address                 String   @db.Text                 // alamat
  moq                     Int      @default(0)              // moq (Minimum Order Quantity, default 0 berarti gak ada MOQ)
  bankName                String?  @db.VarChar(100)         // nama_bank (opsional)
  bankAccount             String?  @db.VarChar(50)          // no_rek (opsional)
  
  // Timestamps
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("suppliers") // Biar di database nama tabelnya jadi snake_case jamak (suppliers)

  stockAuditTrails  StockAuditTrail[]
}

model StockAuditTrail {
  id            Int      @id @default(autoincrement())
  productId     Int      // Barang mana yang diubah
  userId        Int      // Siapa yang ngubah (Admin/Gudang)
  supplierId    Int?     // Dari supplier mana (Nullable, karena kalau opname/hilang mungkin gak butuh supplier)
  
  action        String   @db.VarChar(50)  // Jenis perubahan: "MANUAL_ADJUSTMENT", "STOCK_OPNAME", "PO_RECEIPT"
  initialStock  Int      // Stok awal sebelum diubah (dari berapa)
  adjustment    Int      // Jumlah perubahan (+10 atau -5)
  finalStock    Int      // Stok akhir setelah diubah (ke berapa)
  notes         String?  @db.Text         // Alasan diubah (misal: "Barang rusak", "Kelebihan input")
  
  createdAt     DateTime @default(now())

  // Relations (Sesuaikan dengan nama model di project lu)
  product       product  @relation(fields: [productId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
  supplier      Supplier? @relation(fields: [supplierId], references: [id])

  @@map("stock_audit_trails")
}

model StockOpname {
  id           Int               @id @default(autoincrement())
  opname_code  String            @unique @db.VarChar(191)
  notes        String?           @db.Text
  user_id      Int               @db.Int
  created_at   DateTime          @default(now()) @db.DateTime(3)


  user         User             @relation(fields: [user_id], references: [id], map: "stock_opnames_user_id_fkey")
  items        StockOpnameItem[]

  @@map("stock_opnames")
}

model StockOpnameItem {
  id              Int         @id @default(autoincrement())
  stock_opname_id Int         @db.Int
  product_id      Int         @db.Int
  system_stock    Int         @db.Int
  physical_stock  Int         @db.Int
  variance        Int         @db.Int


  opname          StockOpname @relation(fields: [stock_opname_id], references: [id], onDelete: Cascade, map: "stock_opname_items_opname_id_fkey")
  product         product     @relation(fields: [product_id], references: [id], map: "stock_opname_items_product_id_fkey")

  @@unique([stock_opname_id, product_id])
  @@map("stock_opname_items")
}